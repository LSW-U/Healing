# 共时海后端环境变量示例
# 复制本文件为 .env 后填入真实值（.env 不要提交到 git）

# 服务端口
PORT=3000

# JWT 签名密钥（生产环境务必改成随机长字符串）
JWT_SECRET=gongsihai-dev-secret-change-me

# 微信小程序配置（填入你的小程序 appid / secret 后，即自动关闭开发模式）
# 未配置时进入「开发模式」：可用任意 code（如 "dev"）直接登录，方便本地联调
WX_APPID=
WX_SECRET=

# 数据库文件路径（默认 后端/data/gongsihai.db，留空即可）
# DB_PATH=
