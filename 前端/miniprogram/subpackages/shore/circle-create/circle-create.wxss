.cc-page{padding:40rpx 48rpx;min-height:100vh;background:var(--moonwhite)}
.cc-item{margin-bottom:32rpx}
.cc-label{font-family:"Songti SC",serif;font-size:24rpx;color:var(--smoke);letter-spacing:2rpx;margin-bottom:16rpx}
.cc-input{width:100%;background:#fff;border-radius:20rpx;border:2rpx solid var(--mist);padding:24rpx 28rpx;font-size:26rpx;color:var(--ink)}
.cc-opts{display:flex;gap:16rpx}
.cc-opt{padding:20rpx 40rpx;border-radius:24rpx;border:2rpx solid var(--mist);font-size:24rpx;color:var(--smoke)}
.cc-opt.active{border-color:var(--tidal);color:var(--tidal-deep);background:rgba(91,123,138,.08)}
.cc-btn{margin-top:48rpx;width:100%;background:var(--tidal);color:#fff;padding:28rpx;border-radius:48rpx;font-size:28rpx;letter-spacing:4rpx;border:none}
