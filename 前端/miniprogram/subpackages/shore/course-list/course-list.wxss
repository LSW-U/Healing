.page{padding:0 36rpx 140rpx}
.cl-cats{display:flex;gap:12rpx;padding:0 8rpx 28rpx;overflow-x:auto;white-space:nowrap}
.cl-cat{font-size:22rpx;padding:8rpx 22rpx;border-radius:24rpx;flex-shrink:0;letter-spacing:2rpx}
.cl-cat.active{background:var(--tidal);color:#fff}
.cl-cat:not(.active){background:var(--mist);color:var(--smoke)}
.cl-card{display:flex;gap:24rpx;padding:28rpx 8rpx;border-bottom:2rpx solid var(--mist)}
.cl-cover{width:168rpx;height:168rpx;border-radius:24rpx;flex-shrink:0}
.cl-info{flex:1;display:flex;flex-direction:column;justify-content:center}
.cl-title{font-family:"Songti SC",serif;font-size:28rpx;color:var(--ink);font-weight:500;letter-spacing:2rpx;line-height:1.4}
.cl-meta{font-size:22rpx;color:var(--smoke);margin-top:10rpx}
.cl-bottom{display:flex;justify-content:space-between;align-items:center;margin-top:16rpx}
.cl-price{font-family:"Songti SC",serif;color:var(--tidal-deep);font-size:28rpx;font-weight:500}
.cl-tag{font-size:18rpx;color:var(--wood);background:rgba(201,181,154,.18);padding:4rpx 14rpx;border-radius:16rpx}
