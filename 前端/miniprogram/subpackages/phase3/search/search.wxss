.sr-page{padding:20rpx 36rpx 140rpx;min-height:100vh;background:var(--moonwhite)}
.sr-bar{display:flex;align-items:center;gap:20rpx}
.sr-input{flex:1;background:#fff;border-radius:40rpx;padding:20rpx 32rpx;font-size:28rpx;border:2rpx solid var(--mist)}
.sr-cancel{font-size:26rpx;color:var(--tidal);flex-shrink:0}
.sr-results{margin-top:28rpx}
.sr-item{display:flex;gap:24rpx;padding:24rpx 8rpx;border-bottom:2rpx solid var(--mist)}
.sr-thumb{width:96rpx;height:96rpx;border-radius:16rpx;flex-shrink:0}
.sr-info{flex:1;display:flex;flex-direction:column;justify-content:center}
.sr-title{font-size:26rpx;color:var(--ink);font-weight:500;line-height:1.4}
.sr-sub{font-size:20rpx;color:var(--smoke);margin-top:8rpx}
.sr-hot{margin-top:48rpx}
.sr-hot-title{font-family:"Songti SC",serif;font-size:24rpx;color:var(--smoke);letter-spacing:2rpx;margin-bottom:24rpx}
.sr-tags{display:flex;flex-wrap:wrap;gap:16rpx}
.sr-tag{font-size:22rpx;background:rgba(91,123,138,.08);color:var(--tidal-deep);padding:12rpx 28rpx;border-radius:28rpx;letter-spacing:2rpx}
