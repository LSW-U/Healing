.ar-page{padding:0 36rpx 140rpx;min-height:100vh;background:var(--moonwhite)}
.ar-card{background:#fff;border-radius:24rpx;overflow:hidden;border:2rpx solid var(--mist);margin-bottom:24rpx}
.ar-cover{height:200rpx;display:flex;align-items:flex-end;padding:0 32rpx 20rpx}
.ar-symbol{font-family:"Songti SC",serif;font-size:72rpx;color:rgba(245,243,239,.9)}
.ar-body{padding:24rpx 32rpx 28rpx}
.ar-title{font-family:"Songti SC",serif;font-size:28rpx;color:var(--ink);font-weight:500;letter-spacing:2rpx}
.ar-meta{font-size:22rpx;color:var(--smoke);margin-top:8rpx}
.ar-desc{font-size:22rpx;color:var(--smoke);margin-top:12rpx;line-height:1.6}
