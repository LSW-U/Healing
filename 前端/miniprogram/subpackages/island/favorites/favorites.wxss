.fv-page{padding:0 36rpx 140rpx}
.fv-cats{display:flex;gap:12rpx;padding:0 8rpx 28rpx}
.fv-cat{font-size:22rpx;padding:8rpx 22rpx;border-radius:24rpx;letter-spacing:2rpx}
.fv-cat.active{background:var(--tidal);color:#fff}
.fv-cat:not(.active){background:var(--mist);color:var(--smoke)}
.fv-group{font-family:"Songti SC",serif;font-size:22rpx;color:var(--smoke);letter-spacing:4rpx;margin:32rpx 8rpx 16rpx}
.fv-item{display:flex;gap:24rpx;padding:20rpx 8rpx;border-bottom:2rpx solid var(--mist)}
.fv-thumb{width:104rpx;height:104rpx;border-radius:20rpx;flex-shrink:0}
.fv-info{flex:1;display:flex;flex-direction:column;justify-content:center}
.fv-title{font-size:26rpx;color:var(--ink);font-weight:500;font-family:"Songti SC",serif;letter-spacing:2rpx;line-height:1.4}
.fv-meta{font-size:20rpx;color:var(--smoke);margin-top:8rpx}
.fv-empty{text-align:center;padding:120rpx;font-size:24rpx;color:var(--smoke);font-family:"Songti SC",serif}
