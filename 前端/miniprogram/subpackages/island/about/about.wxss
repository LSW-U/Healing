.ab-page{padding:60rpx 48rpx;min-height:100vh;background:var(--moonwhite)}
.ab-logo{font-family:"Songti SC",serif;font-size:48rpx;letter-spacing:12rpx;color:var(--tidal-deep);text-align:center}
.ab-sub{font-size:24rpx;color:var(--smoke);text-align:center;margin-top:16rpx;letter-spacing:4rpx}
.ab-sec{margin-top:48rpx}
.ab-lab{font-family:"Songti SC",serif;font-size:22rpx;color:var(--smoke);letter-spacing:4rpx;margin-bottom:16rpx}
.ab-txt{font-size:26rpx;color:var(--ink);line-height:1.8;letter-spacing:1rpx}
.ab-notice{margin-top:60rpx;padding:24rpx;background:rgba(184,116,106,.06);border-left:4rpx solid var(--dusk);border-radius:12rpx;font-size:22rpx;color:#7a4a42;line-height:1.7}
