/* 岸·连接页（P10） */
.page{padding:0 36rpx 140rpx;min-height:100vh;box-sizing:border-box}
.sh-greet{font-family:"Songti SC",serif;font-size:26rpx;color:var(--smoke);padding:12rpx 4rpx 32rpx;letter-spacing:2rpx}
.sh-greet text{color:var(--ink);font-weight:500}
.sh-circle-card{background:linear-gradient(150deg,var(--tidal) 0%,var(--tidal-deep) 100%);border-radius:32rpx;padding:32rpx 36rpx;color:var(--moonwhite);margin-bottom:36rpx;position:relative}
.sh-circle-card .go{position:absolute;right:32rpx;top:50%;transform:translateY(-50%);font-size:36rpx;opacity:.6}
.sh-circle-card .tag{font-size:18rpx;letter-spacing:4rpx;opacity:.8;font-family:"Songti SC",serif}
.sh-circle-card .name{font-family:"Songti SC",serif;font-size:28rpx;margin:12rpx 0 20rpx;letter-spacing:2rpx;font-weight:500}
.sh-circle-card .prog-row{display:flex;justify-content:space-between;align-items:center;font-size:18rpx;opacity:.85;letter-spacing:2rpx}
.sh-circle-card .prog{flex:1;height:6rpx;background:rgba(245,243,239,.25);border-radius:6rpx;margin:0 20rpx;position:relative}
.sh-circle-card .prog-bar{position:absolute;left:0;top:0;height:100%;width:66%;background:var(--wood);border-radius:6rpx}
.sh-sec-title{font-family:"Songti SC",serif;font-size:22rpx;color:var(--smoke);letter-spacing:4rpx;margin:0 4rpx 20rpx}
.sh-entry{display:flex;align-items:center;gap:26rpx;padding:30rpx 8rpx;border-bottom:2rpx solid var(--mist)}
.sh-entry:last-child{border-bottom:none}
.sh-ico{width:76rpx;height:76rpx;border-radius:20rpx;display:flex;align-items:center;justify-content:center;font-family:"Songti SC",serif;font-size:34rpx;flex-shrink:0;font-weight:500}
.sh-info{flex:1}
.sh-info .t{font-family:"Songti SC",serif;font-size:28rpx;color:var(--ink);letter-spacing:2rpx;font-weight:500}
.sh-info .s{font-size:20rpx;color:var(--smoke);margin-top:6rpx;letter-spacing:2rpx}
.sh-r{display:flex;align-items:center;gap:16rpx;color:var(--mist-deep);font-size:26rpx}
.sh-r .badge{background:var(--wood);color:#fff;font-size:16rpx;padding:4rpx 14rpx;border-radius:16rpx;letter-spacing:2rpx}
