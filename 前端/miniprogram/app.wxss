/* 共时海 · 全局样式（设计 token，由 common.css 转换，原型 1px = 2rpx） */
page {
  --tidal: #5B7B8A;
  --tidal-deep: #4A6B7A;
  --moonwhite: #F5F3EF;
  --mist: #ECE8E1;
  --wood: #C9B59A;
  --ink: #33393D;
  --smoke: #9AA0A4;
  --ink-green: #3F5E5A;

  background: var(--moonwhite);
  color: var(--ink);
  font-family: "Songti SC", "STSong", "PingFang SC", -apple-system, sans-serif;
  font-size: 28rpx;
}

view, text, button { box-sizing: border-box; }

/* 通用按钮（主/次），对应 03 交互文档 */
.btn-primary {
  background: var(--tidal);
  color: #fff;
  border-radius: 40rpx;
  padding: 22rpx 0;
  text-align: center;
  letter-spacing: 4rpx;
  border: none;
}
.btn-primary:active { opacity: .9; }

/* 页面基础容器 */
.page {
  min-height: 100vh;
  padding: 0 36rpx 120rpx;
  box-sizing: border-box;
}
