.jr-page{padding:0 36rpx 140rpx;min-height:100vh;background:var(--moonwhite);position:relative}
.jr-month-bar{display:flex;justify-content:space-between;align-items:center;padding:8rpx 4rpx 28rpx}
.jr-arr{color:var(--smoke);font-size:36rpx}
.jr-m{font-family:"Songti SC",serif;font-size:30rpx;color:var(--ink);letter-spacing:4rpx}
.jr-term{font-size:20rpx;color:var(--wood);font-weight:400;margin-left:16rpx;letter-spacing:2rpx}
.jr-toggle{background:var(--mist);border:none;border-radius:28rpx;font-size:20rpx;letter-spacing:4rpx;color:var(--tidal-deep);font-family:"Songti SC",serif;padding:12rpx 30rpx}
.jr-week{display:grid;grid-template-columns:repeat(7,1fr);text-align:center;font-size:20rpx;color:var(--smoke);font-family:"Songti SC",serif;letter-spacing:2rpx;padding-bottom:8rpx}
.jr-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:8rpx;margin-bottom:16rpx}
.jr-cell{aspect-ratio:1;display:flex;align-items:center;justify-content:center;font-size:24rpx;color:var(--ink);border-radius:20rpx;position:relative;font-family:"Songti SC",serif}
.jr-cell.empty{visibility:hidden}
.jr-cell.has{background:#fff;border:2rpx solid var(--mist)}
.jr-dot{position:absolute;bottom:8rpx;width:10rpx;height:10rpx;border-radius:50%;background:var(--tidal)}
.jr-cell.today{background:var(--tidal);color:#fff}
.jr-cell.today .jr-dot{background:#fff}
.jr-list{flex:1}
.jr-item{background:#fff;border-radius:28rpx;border:2rpx solid var(--mist);padding:28rpx 32rpx;margin-bottom:24rpx}
.jri-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:16rpx}
.jri-date{font-family:"Songti SC",serif;font-size:24rpx;color:var(--ink);letter-spacing:2rpx}
.jri-moon{font-size:20rpx;color:var(--ink-green);font-family:"Songti SC",serif;letter-spacing:2rpx}
.jri-mood{font-size:22rpx;color:var(--wood);font-family:"Songti SC",serif;letter-spacing:4rpx;margin-bottom:12rpx}
.jri-txt{font-size:24rpx;color:var(--ink);line-height:1.7;letter-spacing:1rpx}
.jri-rel{font-size:20rpx;color:var(--smoke);margin-top:16rpx;font-family:"Songti SC",serif}
.jri-rel text{color:var(--tidal-deep);font-weight:500}
.jr-add{position:fixed;right:40rpx;bottom:160rpx;width:100rpx;height:100rpx;border-radius:50%;background:var(--tidal);color:#fff;font-size:48rpx;display:flex;align-items:center;justify-content:center;box-shadow:0 12rpx 32rpx rgba(91,123,138,.35);border:none;z-index:10}
