.st-page{padding:20rpx 36rpx 60rpx;min-height:100vh;background:var(--moonwhite)}
.st-group{margin-bottom:24rpx}
.st-item{display:flex;justify-content:space-between;align-items:center;padding:32rpx 32rpx;background:#fff;border-radius:20rpx;border:2rpx solid var(--mist);margin-bottom:2rpx}
.st-label{font-size:28rpx;color:var(--ink)}
.st-arrow{font-size:24rpx;color:var(--mist-deep)}
.st-val{font-size:24rpx;color:var(--smoke)}
.st-notice{margin-top:48rpx;font-size:22rpx;color:var(--smoke);line-height:1.7;text-align:center}
