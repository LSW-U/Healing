.tc-page{padding:40rpx 36rpx;min-height:100vh;background:var(--moonwhite)}
.tc-header{background:linear-gradient(135deg,var(--tidal-deep),var(--tidal));border-radius:32rpx;padding:48rpx 40rpx;color:var(--moonwhite);text-align:center;margin-bottom:32rpx}
.tc-tide-level{font-family:"Songti SC",serif;font-size:56rpx;letter-spacing:8rpx;font-weight:500}
.tc-streak{font-size:24rpx;opacity:.85;margin-top:16rpx;letter-spacing:4rpx}
.tc-status{margin-top:24rpx;font-size:22rpx;opacity:.75}
.tc-records{display:flex;flex-direction:column;gap:4rpx}
.tc-rec{display:flex;align-items:center;gap:20rpx;padding:24rpx 16rpx;border-bottom:2rpx solid var(--mist)}
.tr-date{font-size:24rpx;color:var(--smoke);width:120rpx}
.tr-mood{font-family:"Songti SC",serif;font-size:26rpx;color:var(--ink);min-width:100rpx}
.tr-note{flex:1;font-size:22rpx;color:var(--smoke);text-align:right;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
