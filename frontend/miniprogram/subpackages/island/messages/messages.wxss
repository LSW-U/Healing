.ms-page{padding:0 36rpx;min-height:100vh;background:var(--moonwhite)}
.ms-item{display:flex;align-items:flex-start;gap:24rpx;padding:28rpx 32rpx;background:#fff;border-radius:20rpx;border:2rpx solid var(--mist);margin-bottom:12rpx}
.ms-dot{width:16rpx;height:16rpx;border-radius:50%;background:var(--dusk);margin-top:10rpx;flex-shrink:0}
.ms-info{flex:1}
.ms-title{font-size:26rpx;color:var(--ink);font-weight:500}
.ms-content{font-size:22rpx;color:var(--smoke);margin-top:8rpx;line-height:1.5}
.ms-time{font-size:20rpx;color:var(--smoke);flex-shrink:0}
