/* P15 疗愈师列表 */
.page{padding:0 36rpx 140rpx}
.hl-cats{display:flex;gap:12rpx;padding:0 4rpx 28rpx;overflow-x:auto;white-space:nowrap}
.hl-cat{font-size:22rpx;padding:8rpx 22rpx;border-radius:24rpx;flex-shrink:0;letter-spacing:2rpx}
.hl-cat.active{background:var(--tidal);color:#fff}
.hl-cat:not(.active){background:var(--mist);color:var(--smoke)}
.hl-card{display:flex;gap:26rpx;padding:30rpx 8rpx;border-bottom:2rpx solid var(--mist)}
.hl-avatar{width:108rpx;height:108rpx;border-radius:50%;flex-shrink:0}
.hl-info{flex:1}
.hl-name{font-family:"Songti SC",serif;font-size:30rpx;color:var(--ink);font-weight:500;letter-spacing:2rpx}
.hl-role{font-size:22rpx;color:var(--smoke);margin-top:6rpx;letter-spacing:2rpx}
.hl-quote{font-size:24rpx;color:var(--smoke);margin-top:12rpx;line-height:1.5;font-family:"Songti SC",serif;font-style:italic}
.hl-tags{display:flex;gap:12rpx;margin-top:16rpx}
.hl-tag{font-size:20rpx;color:var(--tidal);background:rgba(91,123,138,.1);padding:4rpx 16rpx;border-radius:16rpx;letter-spacing:2rpx}
.hl-go{color:var(--mist-deep);font-size:26rpx;align-self:center}
