.ed-page{height:100vh;background:var(--moonwhite)}
.ed-cover{height:360rpx;background:linear-gradient(150deg,var(--tidal) 0%,var(--tidal-deep) 100%);display:flex;align-items:flex-end;padding:0 44rpx 44rpx}
.ed-symbol{font-family:"Songti SC",serif;font-size:112rpx;color:rgba(245,243,239,.9);letter-spacing:8rpx}
.ed-body{padding:40rpx 44rpx 200rpx}
.ed-title{font-family:"Songti SC",serif;font-size:40rpx;font-weight:500;letter-spacing:2rpx;color:var(--ink);line-height:1.3}
.ed-guide{font-size:24rpx;color:var(--smoke);margin-top:12rpx;letter-spacing:2rpx;font-family:"Songti SC",serif}
.ed-info{margin-top:32rpx;display:flex;flex-direction:column;gap:20rpx}
.ei-item{display:flex;justify-content:space-between;padding:20rpx 0;border-bottom:2rpx solid var(--mist);font-size:26rpx;color:var(--ink)}
.ei-label{font-family:"Songti SC",serif;color:var(--smoke);letter-spacing:2rpx;font-size:24rpx}
.ed-desc{font-size:26rpx;color:var(--ink);line-height:1.85;margin-top:36rpx;letter-spacing:1rpx}
.ed-desc view{margin-bottom:20rpx}
.ed-notice{margin-top:36rpx;padding:24rpx 28rpx;background:rgba(201,181,154,.12);border-radius:16rpx;font-size:22rpx;color:var(--wood);line-height:1.7}
.ed-actions{position:fixed;bottom:0;left:0;right:0;background:rgba(245,243,239,.96);backdrop-filter:blur(20rpx);-webkit-backdrop-filter:blur(20rpx);border-top:2rpx solid var(--mist);padding:24rpx 44rpx;padding-bottom:calc(24rpx + env(safe-area-inset-bottom))}
.ed-btn{width:100%;background:var(--tidal);color:#fff;border:none;padding:28rpx;border-radius:48rpx;font-size:28rpx;letter-spacing:4rpx}
