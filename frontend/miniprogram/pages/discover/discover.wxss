/* 潮·发现页（P02） */
.page{padding:0 36rpx 140rpx;min-height:100vh;box-sizing:border-box}

/* 三行问候：问候词 / 潮汐将至(高亮) / 落句 */
.greet-block{padding:0 8rpx 32rpx;position:relative}
.greet-search{position:absolute;right:0;top:0;font-size:36rpx;color:var(--smoke);padding:8rpx}
.greet-time{font-family:"Songti SC",serif;font-size:26rpx;color:var(--smoke);letter-spacing:2rpx}
.greet-hl{display:block;font-family:"Songti SC",serif;font-size:40rpx;color:var(--ink);font-weight:600;letter-spacing:6rpx;margin:8rpx 0 4rpx}
.greet-sub{font-family:"Songti SC",serif;font-size:24rpx;color:var(--smoke);letter-spacing:2rpx;opacity:.85}
.card-hero{background:linear-gradient(150deg,var(--tidal) 0%,var(--tidal-deep) 100%);border-radius:32rpx;padding:44rpx 40rpx;color:var(--moonwhite);position:relative;overflow:hidden;margin-bottom:32rpx}
.card-hero .tag{font-size:20rpx;letter-spacing:4rpx;opacity:.85}
.card-hero .title{font-family:"Songti SC",serif;font-size:38rpx;margin:16rpx 0 12rpx;font-weight:500;line-height:1.5;letter-spacing:2rpx}
.card-hero .meta{font-size:22rpx;opacity:.75;display:flex;gap:20rpx;margin-top:28rpx}
.card-hero .play-btn{position:absolute;right:36rpx;bottom:36rpx;width:68rpx;height:68rpx;border-radius:50%;background:rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center;color:#fff;font-size:28rpx}
.sec-header{font-family:"Songti SC",serif;font-size:26rpx;color:var(--ink);margin:40rpx 8rpx 24rpx;letter-spacing:2rpx;display:flex;justify-content:space-between;align-items:center}
.sec-header .more{font-size:22rpx;color:var(--smoke);font-family:-apple-system,sans-serif}
.content-list{display:flex;flex-direction:column}
.content-item{display:flex;align-items:center;gap:24rpx;padding:18rpx 8rpx;border-bottom:2rpx solid var(--mist)}
.content-item:last-child{border-bottom:none}
.ci-thumb{width:128rpx;height:128rpx;border-radius:24rpx;flex-shrink:0}
.ci-info{flex:1;display:flex;flex-direction:column;justify-content:center;min-width:0}
.ci-title{font-size:26rpx;color:var(--ink);font-weight:500;line-height:1.4;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ci-sub{font-size:22rpx;color:var(--smoke);margin-top:10rpx}
.ci-arrow{color:var(--mist-deep);font-size:24rpx;flex-shrink:0}
